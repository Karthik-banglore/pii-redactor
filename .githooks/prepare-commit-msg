#!/bin/sh
# Strip Cursor / AI co-author trailers so GitHub contributors stay clean.
MSG_FILE="$1"
[ -n "$MSG_FILE" ] || exit 0
# macOS / BSD sed
if sed --version >/dev/null 2>&1; then
  sed -i -e '/^Co-authored-by:.*[Cc]ursor/d' \
         -e '/^Co-authored-by:.*cursoragent@cursor\.com/d' \
         -e '/^Made-with: Cursor$/d' \
         "$MSG_FILE"
else
  sed -i '' -e '/^Co-authored-by:.*[Cc]ursor/d' \
            -e '/^Co-authored-by:.*cursoragent@cursor\.com/d' \
            -e '/^Made-with: Cursor$/d' \
            "$MSG_FILE"
fi
exit 0
